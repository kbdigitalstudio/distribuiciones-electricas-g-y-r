# --- GYR Backend Environment Variables (Etapa 2) ---
# Copia este archivo a .env y rellena los valores reales.
# Nunca subas .env con valores reales al repositorio.

# Base de datos PostgreSQL (requerido)
# Configurar con credenciales reales antes de ejecutar npx prisma db push
# Ejemplo: postgresql://usuario:contraseña@localhost:5432/gyr_db?schema=public
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/gyr_db?schema=public"

# Autenticación JWT
JWT_SECRET="cambiar_por_un_secreto_largo_aleatorio_minimo_32_caracteres"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="cambiar_por_otro_secreto_diferente_minimo_32_caracteres"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie de sesión
COOKIE_NAME="gyr_session"
COOKIE_DOMAIN="localhost"        # En producción: dominio real (ej. .gyr.com.co)
COOKIE_SECURE="true"             # true en HTTPS, false solo en desarrollo local sin TLS
COOKIE_SAMESITE="strict"

# CSRF (double submit cookie)
CSRF_COOKIE_NAME="gyr_csrf_token"

# URLs de la aplicación
APP_URL="http://localhost:3000"
APP_PORT="3000"

# Seguridad: rate limiting y fuerza bruta
MAX_LOGIN_ATTEMPTS="5"
LOCKOUT_MINUTES="15"

# Entorno
NODE_ENV="development"